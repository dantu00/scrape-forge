# ScrapeForge Configuration
# Copy this file to .env and customize as needed

# Request Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=1.0

# Proxy Settings
USE_PROXY=false
PROXY_LIST_FILE=proxies.txt

# User Agent Rotation
ROTATE_USER_AGENT=true

# Playwright Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Output Settings
OUTPUT_DIR=output

# Logging
LOG_LEVEL=INFO
LOG_FILE=

